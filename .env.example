# Copia este archivo como .env y reemplaza los valores. NUNCA subas el .env a git.
PORT=3001
NODE_ENV=development

# Conexión de MongoDB Atlas (la usa Mongoose). Incluye el nombre de la base al final (/KRISABELL).
# Si la contraseña tiene símbolos especiales, codifícalos (@ -> %40, : -> %3A, / -> %2F).
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@TU_CLUSTER.mongodb.net/KRISABELL?retryWrites=true&w=majority

# Acceso al panel de administración (contraseña de 12 a 128 caracteres)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=minimo_12_caracteres

# Orígenes del frontend permitidos por CORS, separados por coma y sin "/" final
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
